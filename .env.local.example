# Copy this file to .env.local and fill in your own values.

# Supabase — Settings → API in your project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Email (optional). Without these, invoices and contracts still work —
# "Email it" reports that sending isn't set up and you copy the link instead.
# Get a key at resend.com; EMAIL_FROM must be an address on a domain you have
# verified with them, or the provider will reject the send.
RESEND_API_KEY=
EMAIL_FROM="Your Name <billing@yourdomain.com>"

# Follow-up drafting (optional). Without this, the "Draft a follow-up" panel
# on a client says it isn't set up and nothing else changes. Get a key at
# console.anthropic.com. Only the one client's own records are ever sent, and
# a draft is never sent to anyone — it lands in a box for you to edit.
ANTHROPIC_API_KEY=

# Overnight drafting (optional). With all three of these set, a nightly job
# finds clients who have gone quiet and invoices past their due date, writes a
# follow-up for each and parks it — you open the app to drafts already waiting.
# Nothing is ever sent by the job; you still press send yourself.
#
# The service role key is in Settings → API, under "service_role". It bypasses
# row-level security, so it belongs only in server environment variables —
# never in NEXT_PUBLIC_ anything, and never committed.
# CRON_SECRET can be any long random string; Vercel sends it back as a bearer
# token so the route cannot be triggered by anyone who finds the URL.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Mailbox connections (optional, but required for any inbox feature).
#
# Encrypts stored app passwords and refresh tokens before they are written, so
# a database dump on its own does not hand over anybody's mailbox. Generate:
#   openssl rand -hex 32
# Changing it makes every existing connection unreadable — users would have to
# reconnect — so set it once and keep it.
CREDENTIAL_KEY=

# Outlook and Microsoft 365 (optional). Microsoft retired password access for
# mail apps, so these mailboxes sign in instead. Free — no paid review.
#
# At entra.microsoft.com: App registrations → New registration → accounts in
# any organisational directory and personal Microsoft accounts. Add a Web
# redirect URI per environment:
#   http://localhost:3000/api/connect/microsoft/callback
#   https://your-app.vercel.app/api/connect/microsoft/callback
# Then Certificates & secrets → New client secret.
# API permissions → Microsoft Graph → Delegated → offline_access, and
# APIs my organization uses → Office 365 Exchange Online →
# IMAP.AccessAsUser.All.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Gmail via Google's API (optional, and not needed to connect Gmail).
#
# Gmail already works through the app-password route above, for free. These are
# only for one-click Google sign-in, which needs the *restricted* gmail.readonly
# scope — Google requires an annual paid security assessment before an app using
# it can be published, and in "Testing" it expires refresh tokens after 7 days.
# Leave blank unless that assessment is done.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
