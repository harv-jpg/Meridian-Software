# Copy this file to .env.local and fill in your own values.

# Supabase — Settings → API in your project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Email (optional). Without these, invoices and contracts still work —
# "Email it" reports that sending isn't set up and you copy the link instead.
# Get a key at resend.com; EMAIL_FROM must be an address on a domain you have
# verified with them, or the provider will reject the send.
RESEND_API_KEY=
EMAIL_FROM="Your Name <billing@yourdomain.com>"

# Follow-up drafting (optional). Without this, the "Draft a follow-up" panel
# on a client says it isn't set up and nothing else changes. Get a key at
# console.anthropic.com. Only the one client's own records are ever sent, and
# a draft is never sent to anyone — it lands in a box for you to edit.
ANTHROPIC_API_KEY=
