# Copy this file to .env.local and fill in your own values.

# Supabase — Settings → API in your project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Email (optional). Without these, invoices and contracts still work —
# "Email it" reports that sending isn't set up and you copy the link instead.
# Get a key at resend.com; EMAIL_FROM must be an address on a domain you have
# verified with them, or the provider will reject the send.
RESEND_API_KEY=
EMAIL_FROM="Your Name <billing@yourdomain.com>"

# Follow-up drafting (optional). Without this, the "Draft a follow-up" panel
# on a client says it isn't set up and nothing else changes. Get a key at
# console.anthropic.com. Only the one client's own records are ever sent, and
# a draft is never sent to anyone — it lands in a box for you to edit.
ANTHROPIC_API_KEY=

# Overnight drafting (optional). With all three of these set, a nightly job
# finds clients who have gone quiet and invoices past their due date, writes a
# follow-up for each and parks it — you open the app to drafts already waiting.
# Nothing is ever sent by the job; you still press send yourself.
#
# The service role key is in Settings → API, under "service_role". It bypasses
# row-level security, so it belongs only in server environment variables —
# never in NEXT_PUBLIC_ anything, and never committed.
# CRON_SECRET can be any long random string; Vercel sends it back as a bearer
# token so the route cannot be triggered by anyone who finds the URL.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
